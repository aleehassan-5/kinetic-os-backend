generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ────────────────────────────────────────────────────────────────────────
// Core: workspaces, users, membership
// ────────────────────────────────────────────────────────────────────────

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  timezone  String   @default("Asia/Karachi")
  industry  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Lemon Squeezy billing
  planId               String   @default("starter")
  lemonSqueezyCustomerId String?

  memberships   Membership[]
  leads         Lead[]
  conversations Conversation[]
  integrations  Integration[]
  documents     KnowledgeDocument[]
  workflows     Workflow[]
  apiKeys       ApiKey[]
  notifications Notification[]
  subscription  Subscription?
  invoices      Invoice[]
  socialAccounts SocialAccount[]
  socialPosts    SocialPost[]
  socialComments SocialComment[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  name         String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships   Membership[]
  refreshTokens RefreshToken[]
  notifications Notification[]
}

enum MembershipRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

model Membership {
  id          String           @id @default(cuid())
  userId      String
  workspaceId String
  role        MembershipRole   @default(EDITOR)
  status      MembershipStatus @default(PENDING)
  invitedAt   DateTime         @default(now())
  joinedAt    DateTime?
  lastActiveAt DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ────────────────────────────────────────────────────────────────────────
// Integrations (channels, scheduling, CRM)
// ────────────────────────────────────────────────────────────────────────

enum IntegrationType {
  WHATSAPP
  TELEGRAM
  INSTAGRAM
  MESSENGER
  EMAIL
  CALENDLY
  GOOGLE_CALENDAR
  HUBSPOT
  GOOGLE_SHEETS
}

enum IntegrationStatus {
  CONNECTED
  NOT_CONNECTED
  ERROR
}

model Integration {
  id          String            @id @default(cuid())
  workspaceId String
  type        IntegrationType
  status      IntegrationStatus @default(NOT_CONNECTED)
  detail      String?
  credentials Json? // encrypted at the app layer before persisting
  meta        Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, type])
}

// ────────────────────────────────────────────────────────────────────────
// Lead engine
// ────────────────────────────────────────────────────────────────────────

enum Channel {
  WHATSAPP
  TELEGRAM
  INSTAGRAM
  MESSENGER
  EMAIL
}

enum LeadStatus {
  NEW
  ENGAGED
  QUALIFIED
  MEETING_BOOKED
  CLOSED
  LOST
}

model Lead {
  id            String     @id @default(cuid())
  workspaceId   String
  channel       Channel
  externalId    String // the platform's user/contact id (wa number, tg chat id, ig scoped id...)
  name          String?
  email         String?
  phone         String?
  intentScore   Int        @default(0)
  status        LeadStatus @default(NEW)
  lastMessageAt DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  meetings      Meeting[]

  @@unique([workspaceId, channel, externalId])
  @@index([workspaceId, status])
}

model Conversation {
  id            String    @id @default(cuid())
  workspaceId   String
  leadId        String
  channel       Channel
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  messages  Message[]
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSender {
  LEAD
  AI
  AGENT
  SYSTEM
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  direction      MessageDirection
  sender         MessageSender
  content        String
  meta           Json?
  createdAt      DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ────────────────────────────────────────────────────────────────────────
// Knowledge base (vector search via pgvector)
// ────────────────────────────────────────────────────────────────────────

enum DocumentSourceType {
  PDF
  DOCX
  URL
  FAQ
  SHEET
}

enum DocumentStatus {
  QUEUED
  PROCESSING
  INDEXED
  FAILED
}

model KnowledgeDocument {
  id           String             @id @default(cuid())
  workspaceId  String
  title        String
  sourceType   DocumentSourceType
  sourceUrl    String?
  status       DocumentStatus     @default(QUEUED)
  chunkCount   Int                @default(0)
  storageBytes Int                @default(0)
  error        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chunks    KnowledgeChunk[]
}

model KnowledgeChunk {
  id         String                       @id @default(cuid())
  documentId String
  content    String
  tokenCount Int
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime                     @default(now())

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

// ────────────────────────────────────────────────────────────────────────
// Workflow orchestrator
// ────────────────────────────────────────────────────────────────────────

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
}

model Workflow {
  id          String         @id @default(cuid())
  workspaceId String
  name        String
  status      WorkflowStatus @default(DRAFT)
  graph       Json // { nodes: WorkflowNode[], edges: WorkflowEdge[] }
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs      WorkflowRun[]
}

enum WorkflowRunStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
}

model WorkflowRun {
  id         String            @id @default(cuid())
  workflowId String
  status     WorkflowRunStatus @default(QUEUED)
  trigger    Json // the event payload that triggered this run
  logs       Json[] @default([])
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime          @default(now())

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
}

// ────────────────────────────────────────────────────────────────────────
// Scheduling / meetings
// ────────────────────────────────────────────────────────────────────────

enum MeetingSource {
  CALENDLY
  GOOGLE_CALENDAR
}

enum MeetingStatus {
  CONFIRMED
  PENDING
  CANCELLED
  COMPLETED
}

model Meeting {
  id        String        @id @default(cuid())
  leadId    String
  source    MeetingSource
  status    MeetingStatus @default(PENDING)
  topic     String?
  startTime DateTime
  endTime   DateTime
  meetingUrl String?
  createdAt DateTime      @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

// ────────────────────────────────────────────────────────────────────────
// Social media content engine (graphics/reels, AI voiceover, scheduling,
// publishing, and comment-engagement listening)
// ────────────────────────────────────────────────────────────────────────

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  LINKEDIN
}

enum SocialAccountStatus {
  CONNECTED
  NOT_CONNECTED
  ERROR
}

model SocialAccount {
  id                String              @id @default(cuid())
  workspaceId       String
  platform          SocialPlatform
  status            SocialAccountStatus @default(NOT_CONNECTED)
  externalId        String? // page id / IG business account id / TikTok open id / LinkedIn org URN
  displayName       String?
  credentials       Json? // encrypted at the app layer before persisting
  autoReplyComments Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  posts     SocialPost[]
  comments  SocialComment[]

  @@unique([workspaceId, platform])
}

enum SocialContentType {
  REEL
  STATIC_GRAPHIC
  CAROUSEL
  STORY
}

enum SocialPostStatus {
  DRAFT
  GENERATING
  SCHEDULED
  PUBLISHED
  FAILED
}

model SocialPost {
  id             String            @id @default(cuid())
  workspaceId    String
  accountId      String?
  platform       SocialPlatform
  contentType    SocialContentType
  status         SocialPostStatus  @default(DRAFT)
  title          String
  prompt         String? // the brief/hook the creator typed in; drives AI generation
  caption        String?
  script         String? // generated voiceover/reel script
  mediaUrl       String? // generated (or stubbed) graphic/video asset
  voiceoverUrl   String?
  useVoiceover   Boolean           @default(false)
  scheduledAt    DateTime?
  publishedAt    DateTime?
  externalPostId String?
  error          String?
  jobId          String? // BullMQ job id backing the scheduled publish, so it can be cancelled/rescheduled
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   SocialAccount?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  comments  SocialComment[]

  @@index([workspaceId, status])
  @@index([workspaceId, scheduledAt])
}

enum SocialCommentStatus {
  NEW
  REPLIED
  IGNORED
  FAILED
}

model SocialComment {
  id                String              @id @default(cuid())
  workspaceId       String
  accountId         String
  postId            String?
  platform          SocialPlatform
  externalCommentId String
  authorName        String?
  text              String
  status            SocialCommentStatus @default(NEW)
  aiReply           String?
  createdAt         DateTime            @default(now())
  repliedAt         DateTime?

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  post      SocialPost?   @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@unique([accountId, externalCommentId])
  @@index([workspaceId, status])
}

// ────────────────────────────────────────────────────────────────────────
// API keys + notifications
// ────────────────────────────────────────────────────────────────────────

enum ApiKeyScope {
  FULL
  READ_ONLY
}

model ApiKey {
  id          String      @id @default(cuid())
  workspaceId String
  name        String
  keyHash     String      @unique
  keyPreview  String
  scope       ApiKeyScope @default(READ_ONLY)
  lastUsedAt  DateTime?
  createdAt   DateTime    @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

enum NotificationType {
  LEAD
  WORKFLOW
  BILLING
  TEAM
  SYSTEM
}

model Notification {
  id          String           @id @default(cuid())
  workspaceId String
  userId      String?
  type        NotificationType
  title       String
  description String
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ────────────────────────────────────────────────────────────────────────
// Billing (Lemon Squeezy)
// ────────────────────────────────────────────────────────────────────────

enum SubscriptionStatus {
  ON_TRIAL
  ACTIVE
  PAUSED
  PAST_DUE
  UNPAID
  CANCELLED
  EXPIRED
}

model Subscription {
  id                     String             @id @default(cuid())
  workspaceId            String             @unique
  lemonSqueezyId         String             @unique // subscription id from Lemon Squeezy
  lemonSqueezyOrderId    String?
  variantId              String // maps to a plan via PLAN_CONFIG
  planName               String
  status                 SubscriptionStatus @default(ON_TRIAL)
  renewsAt               DateTime?
  endsAt                 DateTime?
  trialEndsAt            DateTime?
  cardBrand              String?
  cardLastFour           String?
  updatePaymentMethodUrl String?
  customerPortalUrl      String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

enum InvoiceStatus {
  PAID
  PENDING
  FAILED
  REFUNDED
}

model Invoice {
  id                  String        @id @default(cuid())
  workspaceId         String
  lemonSqueezyOrderId String        @unique
  amountCents         Int
  currency            String        @default("USD")
  status              InvoiceStatus @default(PENDING)
  invoiceUrl          String?
  billingReason       String?
  issuedAt            DateTime

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, issuedAt])
}
