# ── Core ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
WEB_APP_URL=http://localhost:3000

# ── Database (PostgreSQL with pgvector extension enabled) ────────────
# CREATE EXTENSION IF NOT EXISTS vector;  <- run once on the DB
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/orbit_ai?schema=public"

# ── Redis (BullMQ job queues: workflow execution, AI replies) ────────
REDIS_URL="redis://localhost:6379"

# ── Auth ──────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Encrypts each workspace's own connected channel credentials (Settings →
# Channels: their WhatsApp/Telegram/Instagram tokens) at rest. Leave blank in
# dev — falls back to deriving a key from JWT_ACCESS_SECRET. Set a real
# random string here in production.
CREDENTIALS_ENCRYPTION_KEY=

# ── AI providers (used for RAG chat + intent scoring fallback) ───────
# Leave blank to run in local "stub" mode (deterministic fake embeddings,
# no external calls) — useful for building/demoing without live keys.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_IMAGE_MODEL=gpt-image-1
ANTHROPIC_API_KEY=

# ── Channel adapters ───────────────────────────────────────────────────
# These are only the fallback used when a workspace hasn't connected its own
# account via Settings → Channels yet (or for a single-tenant deployment).
# Each customer normally connects their OWN WhatsApp/Telegram/Instagram/
# Messenger account from inside the app — see POST /channel-connections.

# WhatsApp Cloud API (Meta) — App-level webhook, shared by every workspace;
# each workspace's own Phone Number ID/Access Token route via Settings.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# SECURITY: change this in production — the default is public in this repo.
WHATSAPP_VERIFY_TOKEN=orbit-whatsapp-verify
# SECURITY: required in production — without it, WhatsApp webhook signature
# verification is skipped entirely (server.ts refuses to start until set).
WHATSAPP_APP_SECRET=

# Telegram Bot API — fallback only; each workspace normally connects its own
# bot token via Settings, which auto-registers its own webhook URL.
TELEGRAM_BOT_TOKEN=
# SECURITY: change this. The default below is committed to this public repo,
# so leaving it unchanged in production means the webhook has no real
# verification — server.ts refuses to start in production until this is set.
TELEGRAM_WEBHOOK_SECRET=orbit-telegram-secret

# Instagram / Messenger (Meta Graph API, shares app credentials) — same
# App-level webhook as WhatsApp; each workspace's own Page ID/Page Access
# Token route via Settings.
META_APP_ID=
# SECURITY: required in production — without it, Instagram/Messenger webhook
# signature verification is skipped entirely (server.ts refuses to start until set).
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
# SECURITY: change this in production — the default is public in this repo.
META_VERIFY_TOKEN=orbit-meta-verify

# Email (SMTP inbound relies on a provider webhook e.g. SendGrid/Postmark
# forwarding parsed emails to /webhooks/email; outbound uses SMTP directly)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Orbit AI <hello@orbitai.agency>"
# SECURITY: change this in production — the default is public in this repo.
INBOUND_EMAIL_WEBHOOK_SECRET=orbit-email-secret

# ── Scheduling ──────────────────────────────────────────────────────────
# Calendly: create a Personal Access Token (Integrations → API & Webhooks)
# and grab your event type's URI (GET https://api.calendly.com/event_types).
# Then register a webhook subscription pointing at
# https://<your-api-domain>/webhooks/calendly for invitee.created and
# invitee.canceled — that's the only place a real Meeting row gets created,
# since we don't know a real time until the lead actually books one.
CALENDLY_ACCESS_TOKEN=
CALENDLY_EVENT_TYPE_URI=
CALENDLY_WEBHOOK_SIGNING_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/integrations/google/callback
# "Continue with Google" sign-in (Settings → Google Cloud Console → OAuth
# consent screen). Reuses GOOGLE_CLIENT_ID/SECRET above, add this exact URL
# to "Authorized redirect URIs" on that OAuth client.
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:4000/auth/google/callback
# Google Calendar direct booking: reuses the same service account as Google
# Sheets sync below. Share this specific calendar with
# GOOGLE_SERVICE_ACCOUNT_EMAIL as "Make changes to events", then paste its
# Calendar ID here (Calendar settings → Integrate calendar → Calendar ID).
GOOGLE_CALENDAR_ID=

# ── CRM sync ────────────────────────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ── Social publishing (content engine) ──────────────────────────────────
# AI voiceover for reels/stories (ElevenLabs). Leave blank to generate
# scripts without audio.
ELEVENLABS_API_KEY=

# Instagram + Facebook reuse the META_* app credentials above.
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_PAGE_ID=

# TikTok Content Posting API
TIKTOK_ACCESS_TOKEN=

# LinkedIn UGC Posts API
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_URN=

# ── Billing (Lemon Squeezy) ─────────────────────────────────────────────
# Dashboard → Settings → API to create a key; Settings → Webhooks for the secret.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Variant IDs come from each plan's product page in your Lemon Squeezy store.
LEMONSQUEEZY_VARIANT_STARTER=
LEMONSQUEEZY_VARIANT_GROWTH=
LEMONSQUEEZY_VARIANT_SCALE=

# ── Error monitoring ───────────────────────────────────────────────────
# Leave blank to skip — errors still get logged via pino locally either
# way, just not reported anywhere outside this server. Get a DSN from
# sentry.io (free tier is fine to start) → Settings → Client Keys (DSN).
SENTRY_DSN=

